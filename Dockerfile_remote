FROM prognosis_prediction:2.0

# Only the UNI2-h weights; slides, coords and features stay on the NFS share.

ENTRYPOINT ["python", "python_scripts/external_repositories/TRIDENT-main/run_batch_of_slides.py", \
            "--task", "feat", "--patch_encoder", "uni_v2", \
            "--patch_encoder_ckpt_path", "/nfs-share/models/uni2h/pytorch_model.bin"]
CMD ["--wsi_dir", "/nfs-share/test_docker/wsis", "--job_dir", "/nfs-share/test_docker/trident", "--wsi_ext", ".svs", "--mag", "20", "--patch_size", "224", "--overlap", "0", "--batch_size", "256", "--skip_errors"]
